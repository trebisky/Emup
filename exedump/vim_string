import sys
import os
import re
import subprocess

def show_stuff ( stuff ) :
    ii = 1
    for x in stuff :
        print ( ii, x )
        ii += 1

def get_string ( addr ) :

    cmd = [ "./exedump" ]
    cmd.append ( addr )

    output = subprocess.run ( cmd, stdout=subprocess.PIPE )
    #print ( "Return code: ", output.returncode )
    stuff = output.stdout.decode ( 'utf-8' ).split ( '\n' )

    #show_stuff ( stuff )
    #print ( stuff[0] )
    return stuff[0]

# For my DOS EXE disassembly I see lines like this:
#
#   0x69e  0x0:0x69e      B8D60A            mov ax,0xad6

# ---------------------------------------------------------------
# The game starts here.  Vim gives us the entire original line

orig_line = sys.stdin.readline().rstrip()
strip_line = orig_line.strip()

ww = strip_line.split ()
if len(ww) < 1 :
    print ( " --- Sorry" )
    exit ()

www = ww[-1].split ( "," )
if len(www) < 1 :
    print ( " --- Sorry" )
    exit ()

addr = www[-1]

if addr.startswith ( "0x" ) :
    final = orig_line + "\t; \"" + get_string(addr) + "\""
    print ( final )
    exit ()

print ( " --- Sorry" )

# THE END
