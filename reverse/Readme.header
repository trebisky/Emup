; This disassembly was done by running ndisasm with no options.
; Tom Trebisky  1-14-2019
;
; The file epp512.exe is 84,790 bytes
; 
; The start of this file is actually the EXE file header,
; and it is the intent of this annotation to understand
; the EXE header (and consequently the EXE file itself)
;
; The file epp512.exe is 84790 bytes in size
;   84790/512 = 165.6
;   So we have 165 blocks of 512,
;    and a final 310 bytes (0x136)
;   This value of 0x136 is the "last page size" below.
;
; Note that a "block" is 512 bytes.
;  a "paragraph" is 16 bytes.
;  a "word" is a 2 byte object.
; 
; First, we have the header in 00 to 1B (28 bytes)
;
; So, where does the code (the "load module") start?
; It would seem there are two ways to work this out.
;  Header paragraphs is 0x1e0, so this times 16
;  gives us 16 * 480 = 7680 = 0x1e00.
;  and that seems correct.
; 
; Note that all these 2 byte objects are byte swapped
;  (i.e. these are little endian integers)


00000000  4D5A		; magic number (ascii "MZ")
00000002  3601		; last page size
00000004  A600		; file pages (166)
00000006  FF06		; relocation items
00000008  E001		; header paragraphs
0000000A  2501		; minalloc
0000000C  FFFF		; maxalloc
0000000E  7813		; initial SS
00000010  0008		; initial SP
00000012  45BB		; checksum
00000014  B426		; initial IP
00000016  6F01		; initial CS (pre-relocated)
00000018  1E00		; relocation table offset
0000001A  0000		; overlay number

; CS:IP give the starting address
; 016f:26b4 = 3da4

; Second we have the relocation table
; Note that the relocation table offset given above
;  tells us that the table starts at 0x1e.
; It is a mystery why it does not start at 0x1c
; and just what the 16 bit "word" at 0x1c is.

0000001C  0100		; mystery item

; Here is the relocation table
;  Each relocation entry is described as a pair of words.
;   (each "word" is 2 bytes in this world)
;  So each reloc entry is 4 bytes.
; 
;  Alternately, we have 0x6ff relocation items.
;   This is 0x6ff = 1791
;   Each is 4 bytes in size,
;   so the table uses 7164 bytes
;
;  Note that the "load module" starts at 0x1e00
;   which is 7680 bytes offset in the file.
;   7680 - 7164 = 516 bytes
;   This 516 bytes is 28 bytes for the header,
;   plus 2 bytes for the "mystery item" plus
;   486 bytes of padding so that the "load module"
;   starts on a 512 byte "block" boundary.

0000001E  AD03 0000
00000022  A103 0000
00000026  9103 0000
0000002A  7103 0000

0000002E  59                pop cx
0000002F  0300              add ax,[bx+si]
00000031  004103            add [bx+di+0x3],al
00000034  0000              add [bx+si],al
00000036  2903              sub [bp+di],ax
00000038  0000              add [bx+si],al
......
......
00001C0D  01445C            add [si+0x5c],ax
00001C10  6F                outsw
00001C11  01655C            add [di+0x5c],sp
00001C14  6F                outsw
00001C15  01BC5C6F          add [si+0x6f5c],di
00001C19  01

; Padding after relocation table.
00001C1A  00
00001C1B  0000              add [bx+si],al
00001C1D  0000              add [bx+si],al
......
......
00001DF7  0000              add [bx+si],al
00001DF9  0000              add [bx+si],al
00001DFB  0000              add [bx+si],al

00001DFC  0000
00001DFE  0000

; The "load module" follows, namely the code that
; gets loaded into memory and executed.
; It is here as if the CS register was set to 0x1e00
; (which never happens)
; The actual CS value comes from the header and
;  will be subject to relocation depending on
;  where DOS decides to load the following.
; The header itself does not get loaded.
; However a PSP will get loads (program segment prefix)
; prior to the code, which is 0x100 bytes in size.
;
; START

00001E00  558B
00001E02  EC                in al,dx
00001E03  B84800            mov ax,0x48
00001E06  9A90266F01        call 0x16f:0x2690
.......
.......

THE END
