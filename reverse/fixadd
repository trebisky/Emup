# The original "fixadd" script.

# ndisasm generates a linear address list as the
# leftmost column.  However jumps and calls are
# disassembled as things like:
#   call 0x9b2:0x3e54
#
# To make any sense of where they are going, I convert
# these to linear addresses to match the left column.
#
# Later versions of ndisasm began emitting code like:
#   call word 0x16f:word 0x311d
#
# This program would need to be modified to deal with this.


infile = "epp512_lm.raw"
#infile = "epp512_lm.dis"

def fixcall ( pre, seg, ip )
	addr = seg.hex * 16 + ip.hex
	xaddr = "0x%x" % addr
	if addr < 0x1000
	    rv = pre + "call " + xaddr + "    ;" + seg + ":" + ip
	else
	    rv = pre + "call " + xaddr + "   ;" + seg + ":" + ip
	end
	return rv
end

def fixjmp ( pre, seg, ip )
	addr = seg.hex * 16 + ip.hex
	xaddr = "0x%x" % addr
	if addr < 0x10000
	    rv = pre + "jmp " + xaddr + "     ;" + seg + ":" + ip
	else
	    rv = pre + "jmp " + xaddr + "    ;" + seg + ":" + ip
	end
	return rv
end

IO.foreach(infile) { |line|
    w = line.split("  ",2)
    line2 = w[0].downcase + "  " + w[1]
    if line2 =~ /(.*)call (0x.*):(0x.*)/
	line3 = fixcall $1, $2, $3
	puts line3
    elsif line2 =~ /(.*)jmp (0x.*):(0x.*)/
	line3 = fixjmp $1, $2, $3
	puts line3
    else
	puts line2
    end
}

